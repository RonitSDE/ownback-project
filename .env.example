# ---------------------------------------------------------------- web app (public)
# 84532 = Base Sepolia, 31337 = local anvil
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
# Copy these from contracts/deployments/<chainId>.json after deploying
NEXT_PUBLIC_OWNBACK_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_STOCK_ADDRESS=
NEXT_PUBLIC_ADAPTER_ADDRESS=
NEXT_PUBLIC_CAMPAIGN_ID=1
NEXT_PUBLIC_DEPLOY_BLOCK=0
# Mainnet Coinbase tokenized stock the testnet mock mirrors
NEXT_PUBLIC_STOCK_SYMBOL=AAPLc
# Your Builder Code from base.dev (Settings > Builder Code), e.g. bc_xxxxxxxx
NEXT_PUBLIC_BUILDER_CODE=

# ---------------------------------------------------------------- keeper (server only)
RPC_URL=https://sepolia.base.org
KEEPER_PRIVATE_KEY=
DEPLOYMENT_FILE=contracts/deployments/84532.json
PRICE_SOURCE=coinbase
STOCK_SYMBOL=AAPLc
BUILDER_CODE=
KEEPER_INTERVAL_MS=60000
KEEPER_MAX_PURCHASES=10000
# Reject upstream NAV older than the onchain max price age; weekends may pause settlement.
MAX_SOURCE_AGE_SECONDS=172800
# Static source is restricted to local chains by default. Public testnet override is for controlled demo only.
ALLOW_TESTNET_STATIC_PRICE=false

# ---------------------------------------------------------------- deploy (never commit)
DEPLOYER_PRIVATE_KEY=
KEEPER_ADDRESS=
INITIAL_PRICE_USDC=100000000
DEMO_BUDGET_USDC=5000000000
BASESCAN_API_KEY=

# ---------------------------------------------------------------- Bankr (optional, server-only)
# Legacy v3.3 configuration; v3.4 only permits explicitly read-only research.
# Get a key at bankr.bot/api-keys (needs Agent API + wallet write). Verify with: npm run bankr:check
BANKR_API_KEY=
# BANKR_API_URL=https://api.bankr.bot
# Legacy Bankr operator-wallet borrow API is permanently disabled in v3.4.
BANKR_BORROW_ENABLED=false

# V3.4 USDC commerce pilot (Postgres, one merchant, Base Sepolia only)
DATABASE_URL=postgresql://ownback:change-me-local-only@localhost:5433/ownback
COMMERCE_CHAIN_ID=84532
COMMERCE_RPC_URL=https://sepolia.base.org
COMMERCE_VAULT_ADDRESS=
COMMERCE_USDC_ADDRESS=
COMMERCE_CAMPAIGN_ID=1
COMMERCE_MERCHANT_WALLET=
COMMERCE_ADMIN_PASSWORD=
COMMERCE_SESSION_SECRET=
COMMERCE_DEPLOY_BLOCK=0
COMMERCE_CRON_SECRET=

# Bankr scoped read-only key. Never give public users operator wallet write authority.
BANKR_BORROW_ENABLED=false
BANKR_RESEARCH_ENABLED=false
BANKR_JOB_TOKEN_SECRET=

APP_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------- Shopify Connect — hybrid Web2/Web3 lane
# Standalone Shopify app OAuth, one pilot store; register callback in Shopify app config.
# Domains: https://yourdomain/api/shopify/callback ; webhooks /api/shopify/webhook
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ALLOWED_SHOP=your-pilot.myshopify.com
SHOPIFY_TOKEN_ENCRYPTION_KEY=  # 32 random bytes encoded as 64 hex characters
SHOPIFY_CUSTOMER_SECRET=  # 32+ random characters
SHOPIFY_REFUND_HOLD_HOURS=24
SHOPIFY_CLAIM_FROM_EMAIL=
RESEND_API_KEY=
SHOPIFY_PILOT_DEMO=false
SHOPIFY_REWARD_CHAIN_ID=84532
SHOPIFY_REWARD_RPC_URL=https://sepolia.base.org
SHOPIFY_REWARD_VAULT_ADDRESS=
SHOPIFY_REWARD_DEPLOY_BLOCK=0
SHOPIFY_REWARD_EXECUTOR_KEY=
SHOPIFY_MOCK_PRICE_USDC=100000000
SHOPIFY_LIVE_STOCK_ENABLED=false

# Public merchant vault address for read-only budget/funding button
NEXT_PUBLIC_SHOPIFY_VAULT_ADDRESS=
SHOPIFY_AUTO_EMAIL_CLAIMS=false
SHOPIFY_CLAIM_BATCH_SIZE=10

# Shopify rewards only apply to orders paid after the testnet vault campaign starts
SHOPIFY_REWARD_ACTIVE_FROM=

# OWNBACK Shopping Concierge — Shopify UCP Catalog + Cart (v3.6)
# Must be a publicly hosted HTTPS version of public/profiles/ownback-ucp.json
UCP_AGENT_PROFILE_URL=https://your-domain.com/profiles/ownback-ucp.json
# Optional comma-separated installed Shopify merchant allowlist; defaults to SHOPIFY_ALLOWED_SHOP
SHOPIFY_AGENT_ALLOWED_SHOPS=your-pilot.myshopify.com
# If Shopify returns a checkout link on a verified custom domain, explicitly allowlist its hostname here.
SHOPIFY_AGENT_ALLOWED_CHECKOUT_HOSTS=
# Only if the merchant storefront UCP endpoint uses a verified custom domain.
# Must also be explicitly present in SHOPIFY_AGENT_ALLOWED_CHECKOUT_HOSTS.
SHOPIFY_AGENT_STOREFRONT_HOST=

# v3.9 allocation policy: set to the exact stock bound to the LIVE deployed reward vault.
# Leaving unset makes proposals refuse; this is NOT an inventory/eligibility check.
OWNBACK_PILOT_SETTLEMENT_STOCK=
# Off by default. Requires commerce:migrate, production Postgres, fixed APP_ORIGIN and wallet.
# This only persists non-custodial preference receipts; no trade or delegated allowance.
OWNBACK_PREFERENCE_RECEIPTS_ENABLED=false
